# Copy to .env and fill in. Placeholders only; never commit real values.
SECRET_KEY=change-me
JWT_SIGNING_KEY=change-me-long-random
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=dairy
DB_USER=dairy
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Email (defaults: console backend when DEBUG=True, SMTP otherwise)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com
PASSWORD_RESET_OTP_TTL_MINUTES=10

# Shared throttle cache (required with >1 worker); needs `pip install redis`
REDIS_URL=redis://127.0.0.1:6379/1
# Number of reverse proxies in front of the app (for correct client IP throttling)
NUM_PROXIES=1


